{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "description": "One Event of the Trace ingest protocol v1, as an SDK sends it. $defs/batch is the request body. Lengths count Unicode code points. Unknown fields are allowed and ignored. Some rules of spec.md cannot be expressed here: the serialized size of extra and of an Event.",
  "type": "object",
  "required": ["event_id", "timestamp", "platform", "sdk", "exceptions"],
  "properties": {
    "event_id": {
      "description": "A UUID in canonical form, generated by the SDK; v7 preferred.",
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "timestamp": { "$ref": "#/$defs/timestamp" },
    "platform": { "type": "string", "minLength": 1 },
    "sdk": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "level": { "enum": ["fatal", "error", "warning"], "default": "error" },
    "handled": { "type": "boolean" },
    "mechanism": { "enum": ["onerror", "unhandledrejection", "uncaughtException", "manual"] },
    "exceptions": {
      "description": "From the outermost exception to its cause.",
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/exception" }
    },
    "environment": { "type": "string", "default": "production" },
    "release": { "type": "string" },
    "tags": {
      "type": "object",
      "maxProperties": 50,
      "additionalProperties": { "type": "string", "maxLength": 200 }
    },
    "contexts": {
      "type": "object",
      "properties": {
        "runtime": { "$ref": "#/$defs/context" },
        "os": { "$ref": "#/$defs/context" },
        "browser": { "$ref": "#/$defs/context" }
      }
    },
    "request": {
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "method": { "type": "string" }
      }
    },
    "user": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "extra": {
      "description": "Free JSON. At most 16384 bytes serialized, which this schema cannot check.",
      "type": "object"
    },
    "breadcrumbs": {
      "description": "From the oldest Breadcrumb to the newest.",
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/breadcrumb" }
    },
    "group_key": {
      "description": "A Custom Group Key, which replaces the computed one.",
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    }
  },
  "$defs": {
    "batch": {
      "description": "The request body: 1 to 100 Events, accepted or rejected as a whole.",
      "type": "object",
      "required": ["events"],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#" }
        }
      }
    },
    "timestamp": {
      "description": "An RFC 3339 date in UTC, with milliseconds or a finer fraction.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3,9}(Z|\\+00:00)$"
    },
    "exception": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "maxLength": 8192 },
        "frames": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/frame" }
        },
        "raw_stack": { "type": "string" }
      }
    },
    "frame": {
      "type": "object",
      "properties": {
        "function": { "type": "string" },
        "filename": { "type": "string" },
        "lineno": { "description": "From 1; 0 means unknown.", "type": "integer", "minimum": 0 },
        "colno": { "description": "From 1; 0 means unknown.", "type": "integer", "minimum": 0 },
        "in_app": { "type": "boolean" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "breadcrumb": {
      "type": "object",
      "required": ["timestamp", "type"],
      "properties": {
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "type": {
          "description": "Free; navigation, http, console, ui and custom are suggested.",
          "type": "string",
          "minLength": 1
        },
        "message": { "type": "string", "maxLength": 1024 },
        "data": { "type": "object" }
      }
    }
  }
}
